# SIVS - Super Intelligence Video Studio
# Environment Configuration

# AI-Video-Studio CLI Path (where the studio scripts are located)
STUDIO_PATH=/Users/mac/AI-Video-Studio

# FFmpeg paths (usually in PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# DaVinci Resolve path (for post-processing)
DAVINCI_PATH=/Applications/DaVinci Resolve/DaVinci Resolve.app

# OpenRouter API Key (for LLM plan generation)
# OPENROUTER_API_KEY=your_key_here

# Default template
DEFAULT_TEMPLATE=anonymized_video

# Preview quality: low, medium, high
PREVIEW_QUALITY=low

# Database (for future use)
# DATABASE_URL=file:./dev.db