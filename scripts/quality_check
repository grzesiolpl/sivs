#!/usr/bin/env python3
"""
quality_check — waliduje wygenerowany plik wideo
Użycie: ./scripts/quality_check <project_name> [--preview|--final]
"""
import json
import subprocess
import sys
from pathlib import Path

STUDIO_ROOT = Path(__file__).parent.parent
PROJECTS_DIR = STUDIO_ROOT / "projects"

def probe_video(filepath: Path) -> dict:
    cmd = [
        "ffprobe", "-v", "quiet", "-print_format", "json",
        "-show_format", "-show_streams", "-show_error", str(filepath)
    ]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        return {"error": result.stderr}
    import json as json_lib
    return json_lib.loads(result.stdout)

def check_faces(filepath: Path) -> dict:
    """Placeholder for face detection check - would use a face detector."""
    return {
        "checked": False,
        "note": "Face detection not implemented yet. Use manual review."
    }

def quality_check(project_name: str, stage: str = "preview"):
    project_dir = PROJECTS_DIR / project_name
    if not project_dir.exists():
        print(f"❌ Projekt '{project_name}' nie istnieje")
        return False

    # Find the rendered file
    if stage == "preview":
        video_files = list((project_dir / "previews").glob("preview_*.mp4"))
    else:
        video_files = list((project_dir / "output").glob("*.mp4"))

    if not video_files:
        print(f"❌ Brak pliku wideo do sprawdzenia w {stage}/")
        return False

    # Use the most recent
    video_path = max(video_files, key=lambda f: f.stat().st_mtime)
    print(f"🔍 Sprawdzam: {video_path.name}")

    info = probe_video(video_path)
    if "error" in info:
        print(f"❌ ffprobe error: {info['error']}")
        return False

    fmt = info.get("format", {})
    video_stream = next((s for s in info.get("streams", []) if s.get("codec_type") == "video"), {})
    audio_stream = next((s for s in info.get("streams", []) if s.get("codec_type") == "audio"), {})

    # Load plan for comparison
    plan_path = project_dir / "edit_plan.json"
    with open(plan_path) as f:
        plan = json.load(f)

    expected = plan.get("output", {})
    expected_w = expected.get("resolution", "1920x1080").split("x")[0]
    expected_h = expected.get("resolution", "1920x1080").split("x")[1]
    expected_duration = sum(
        (op.get("end", 0) - op.get("start", 0))
        for op in plan.get("operations", [])
        if op.get("action") in ("keep_range", "trim") or op.get("op") == "trim"
    )

    actual_duration = float(fmt.get("duration", 0))
    actual_w = video_stream.get("width")
    actual_h = video_stream.get("height")
    actual_codec = video_stream.get("codec_name")
    has_audio = audio_stream is not None

    print(f"\n📊 Raport QC:")
    print(f"   Duration:  {actual_duration:.2f}s (oczekiwano ~{expected_duration:.2f}s)")
    print(f"   Resolution: {actual_w}x{actual_h} (oczekiwano {expected_w}x{expected_h})")
    print(f"   Codec:     {actual_codec} (oczekiwano {expected.get('video_codec', 'libx264')})")
    print(f"   Audio:     {'TAK' if has_audio else 'NIE'}")
    print(f"   Bitrate:   {int(fmt.get('bit_rate', 0)) // 1000} kbps")
    print(f"   Size:      {int(fmt.get('size', 0)) / 1024 / 1024:.1f} MB")

    # Checks
    issues = []
    if expected_w and actual_w != int(expected_w):
        issues.append(f"Rozdzielczość szerokość: {actual_w} != {expected_w}")
    if expected_h and actual_h != int(expected_h):
        issues.append(f"Rozdzielczość wysokość: {actual_h} != {expected_h}")
    if abs(actual_duration - expected_duration) > 2.0:  # 2s tolerance
        issues.append(f"Czas trwania: {actual_duration:.1f}s vs plan {expected_duration:.1f}s (roznica > 2s)")
    if not has_audio:
        issues.append("Brak ścieżki audio")

    # Face check (placeholder)
    face_result = check_faces(video_path)

    # Save QC report
    qa_report = {
        "project": project_name,
        "stage": stage,
        "file": str(video_path.relative_to(project_dir)),
        "checks": {
            "duration": {"expected": expected_duration, "actual": actual_duration, "ok": abs(actual_duration - expected_duration) <= 2.0},
            "resolution": {"expected": f"{expected_w}x{expected_h}", "actual": f"{actual_w}x{actual_h}", "ok": actual_w == int(expected_w) and actual_h == int(expected_h)},
            "codec": {"expected": expected.get("video_codec"), "actual": actual_codec, "ok": actual_codec == expected.get("video_codec")},
            "audio": {"ok": has_audio},
            "faces": face_result,
        },
        "issues": issues,
        "passed": len(issues) == 0
    }

    report_path = project_dir / f"qa_report_{stage}.json"
    with open(report_path, "w") as f:
        json.dump(qa_report, f, indent=2)

    print(f"\n{'✅ QC PASSED' if qa_report['passed'] else '❌ QC FAILED'}")
    for issue in issues:
        print(f"   ⚠️  {issue}")
    print(f"📄 Raport: {report_path}")

    return qa_report["passed"]

def main():
    import argparse
    parser = argparse.ArgumentParser(description="Quality check rendered video")
    parser.add_argument("project", help="Project name")
    parser.add_argument("--stage", choices=["preview", "final"], default="preview", help="Which render to check")
    args = parser.parse_args()

    success = quality_check(args.project, args.stage)
    sys.exit(0 if success else 1)

if __name__ == "__main__":
    main()